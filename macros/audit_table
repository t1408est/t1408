{% macro audit_columns(existing_model=None, unique_key='id') %}
    {% if is_incremental() and existing_model %}
        , CASE
            WHEN {{ existing_model }}.{{ unique_key }} IS NULL THEN {{ dbt_utils.current_timestamp() }}
            ELSE {{ existing_model }}.created_at
          END AS created_at
        , {{ dbt_utils.current_timestamp() }} AS updated_at
    {% else %}
        , {{ dbt_utils.current_timestamp() }} AS created_at
        , {{ dbt_utils.current_timestamp() }} AS updated_at
    {% endif %}
{% endmacro %}
